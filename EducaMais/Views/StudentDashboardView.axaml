<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EducaMais.ViewModels"
             x:DataType="vm:StudentDashboardViewModel"
             x:Class="EducaMais.Views.StudentDashboardView">
  
  <Grid RowDefinitions="Auto, *" Background="#f4f6f8">
      <!-- HEADER -->
      <Border Grid.Row="0" Background="White" Padding="30" BoxShadow="0 4 15 0 #05000000" ZIndex="5">
          <Grid ColumnDefinitions="Auto, *, Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                  <Border Background="#e6f4ea" CornerRadius="50" Width="60" Height="60">
                      <TextBlock Text="🎓" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Bem-vindo(a)," FontSize="14" Foreground="#888888" FontWeight="Bold"/>
                      <TextBlock Text="{Binding StudentName}" FontSize="24" FontWeight="Black" Foreground="#333333"/>
                      <TextBlock Text="{Binding SchoolName, StringFormat='{}Escola: {0}'}" FontSize="14" Foreground="#a98a44" FontWeight="SemiBold" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding ClassName, StringFormat='{}Turma: {0}'}" FontSize="12" Foreground="#999"/>
                  </StackPanel>
              </StackPanel>

              <Button Grid.Column="2" Content="Sair" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#d93025" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
          </Grid>
      </Border>

      <!-- CONTENT -->
      <ScrollViewer Grid.Row="1">
          <StackPanel Margin="40" Spacing="30">
              
              <!-- CARDS SUPERIORES -->
              <Grid ColumnDefinitions="*, *" Margin="0,0,0,10">
                  
                  <!-- Frequência -->
                  <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,15,0" BoxShadow="0 4 15 0 #05000000">
                      <StackPanel Spacing="10">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="📅" FontSize="20"/>
                              <TextBlock Text="Minha Frequência" FontSize="18" FontWeight="Black" Foreground="#333333"/>
                          </StackPanel>
                          <TextBlock Text="{Binding AttendancePercentage, StringFormat='{}{0:F1}% de Presença'}" FontSize="32" FontWeight="Black" Foreground="#28a745" Margin="0,10,0,0"/>
                          <TextBlock Text="{Binding TotalAbsences, StringFormat='{}Você possui {0} faltas não justificadas até o momento.'}" FontSize="14" Foreground="#888"/>
                      </StackPanel>
                  </Border>

                  <!-- Mural de Avisos -->
                  <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="15,0,0,0" BoxShadow="0 4 15 0 #05000000">
                      <StackPanel Spacing="10">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="📢" FontSize="20"/>
                              <TextBlock Text="Mural da Direção" FontSize="18" FontWeight="Black" Foreground="#333333"/>
                          </StackPanel>
                          <Border Background="#fff9ed" CornerRadius="8" Padding="15" Margin="0,10,0,0" BorderBrush="#fbe2b5" BorderThickness="1">
                              <StackPanel Spacing="5">
                                  <TextBlock Text="Reunião de Pais e Mestres" FontWeight="Bold" Foreground="#a98a44"/>
                                  <TextBlock Text="Acontecerá no próximo sábado letivo. A presença de um responsável é obrigatória para entrega dos resultados físicos." Foreground="#666" TextWrapping="Wrap"/>
                              </StackPanel>
                          </Border>
                      </StackPanel>
                  </Border>

              </Grid>

              <!-- BOLETIM -->
              <Border Background="White" CornerRadius="12" Padding="30" BoxShadow="0 4 15 0 #05000000">
                  <StackPanel Spacing="20">
                      <TextBlock Text="Boletim Oficial" FontSize="22" FontWeight="Black" Foreground="#333333"/>
                      
                      <Grid ColumnDefinitions="3*, *, *, *, *, *" Margin="0,10,0,10">
                          <TextBlock Grid.Column="0" Text="Disciplina" FontWeight="Bold" Foreground="#999999"/>
                          <TextBlock Grid.Column="1" Text="Unidade 1" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="Unidade 2" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="Unidade 3" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="Unidade 4" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center" ToolTip.Tip="Apenas em modelo tradicional (4 bimestres)"/>
                          <TextBlock Grid.Column="5" Text="Situação Final" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding ReportCards}">
                          <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                  <Border BorderBrush="#f0f0f0" BorderThickness="0,0,0,1" Padding="0,15">
                                      <Grid ColumnDefinitions="3*, *, *, *, *, *">
                                          <TextBlock Grid.Column="0" Text="{Binding Student.Name}" FontSize="16" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                          
                                          <!-- Exibe TradU1 ou TotalU1 (dependendo do modelo) -->
                                          <TextBlock Grid.Column="1" Text="{Binding DisplayU1}" FontSize="16" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          <TextBlock Grid.Column="2" Text="{Binding DisplayU2}" FontSize="16" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          <TextBlock Grid.Column="3" Text="{Binding DisplayU3}" FontSize="16" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          <TextBlock Grid.Column="4" Text="{Binding DisplayU4}" FontSize="16" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          
                                          <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                              <TextBlock Text="{Binding FinalAverage, StringFormat={}{0:F1}}" FontSize="20" FontWeight="Black" Foreground="{Binding StatusColor}" HorizontalAlignment="Center"/>
                                              <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Center"/>
                                          </StackPanel>
                                      </Grid>
                                  </Border>
                              </DataTemplate>
                          </ItemsControl.ItemTemplate>
                      </ItemsControl>

                  </StackPanel>
              </Border>
          </StackPanel>
      </ScrollViewer>
  </Grid>
</UserControl>
