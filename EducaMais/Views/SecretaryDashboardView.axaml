<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EducaMais.ViewModels"
             x:Class="EducaMais.Views.SecretaryDashboardView"
             x:DataType="vm:SecretaryDashboardViewModel"
             x:Name="RootControl"
             Background="#f4f4f4">

  <UserControl.Styles>
    <Style Selector="Button.sidebar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#666666"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.sidebar_active">
      <Setter Property="Background" Value="#fdf3de"/>
      <Setter Property="Foreground" Value="#a98a44"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#a98a44"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="250" PaneBackground="#e8e8e8">
      <SplitView.Pane>
        <StackPanel Spacing="5" Margin="0,20">
          <TextBlock Text="Educa+" FontSize="24" FontWeight="ExtraBold" Foreground="#a98a44" Margin="25,0,0,30"/>
          
          <Button Content="  Visão geral" Classes.sidebar="{Binding !IsVisaoGeralVisible}" Classes.sidebar_active="{Binding IsVisaoGeralVisible}" Command="{Binding NavigateCommand}" CommandParameter="VisaoGeral"/>
          <Button Content="  Escolas" Classes.sidebar="{Binding !IsEscolasVisible}" Classes.sidebar_active="{Binding IsEscolasVisible}" Command="{Binding NavigateCommand}" CommandParameter="Escolas"/>
          <Button Content="  Diretores" Classes.sidebar="{Binding !IsDiretoresVisible}" Classes.sidebar_active="{Binding IsDiretoresVisible}" Command="{Binding NavigateCommand}" CommandParameter="Diretores"/>
          <Button Content="  Relatórios" Classes.sidebar="{Binding !IsRelatoriosVisible}" Classes.sidebar_active="{Binding IsRelatoriosVisible}" Command="{Binding NavigateCommand}" CommandParameter="Relatorios"/>
          <Button Content="  Bolsa Família" Classes.sidebar="{Binding !IsSocialReportVisible}" Classes.sidebar_active="{Binding IsSocialReportVisible}" Command="{Binding ShowSocialReportCommand}"/>
        </StackPanel>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid>
          <ScrollViewer>
            <StackPanel Spacing="25" Margin="40">
              <!-- Top Header -->
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel>
                  <TextBlock Text="SECRETARIA MUNICIPAL" FontSize="10" FontWeight="Bold" Foreground="#a98a44" LetterSpacing="1"/>
                  <TextBlock Text="{Binding TenantName}" FontSize="28" FontWeight="Black" Foreground="#333333"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BackupMessage}" VerticalAlignment="Center" Foreground="#0056b3" FontWeight="Bold" IsVisible="{Binding HasBackupMessage}"/>
                    <Button Classes="primary" Content="💾 Exportar Backup (Auditoria)" Command="{Binding ExportMunicipalBackupCommand}" IsEnabled="{Binding !IsExporting}" CornerRadius="6" Background="#28a745" Foreground="White" FontWeight="Bold" Padding="15,8"/>
                    <Button Classes="sidebar" Content="⌂ Voltar (Sair)" Command="{Binding LogoutCommand}" />
                </StackPanel>
              </Grid>

              <!-- Painel Visão Geral -->
              <StackPanel Spacing="20" IsVisible="{Binding IsVisaoGeralVisible}">
                
                <Grid ColumnDefinitions="*,*,*">
                  <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,10,0" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <TextBlock Text="🏫" FontSize="24"/>
                      <TextBlock Text="Escolas Ativas" FontSize="14" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Text="{Binding TotalEscolas}" FontSize="36" FontWeight="Black" Foreground="#333333"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="10,0" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <TextBlock Text="👩‍🏫" FontSize="24"/>
                      <TextBlock Text="Diretores" FontSize="14" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Text="{Binding TotalDiretores}" FontSize="36" FontWeight="Black" Foreground="#333333"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="25" Margin="10,0,0,0" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                    <StackPanel Spacing="10">
                      <TextBlock Text="📊" FontSize="24"/>
                      <TextBlock Text="Média Rede" FontSize="14" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Text="{Binding MediaRede}" FontSize="36" FontWeight="Black" Foreground="#1e8e3e"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Background="White" CornerRadius="12" Padding="25" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Ações Rápidas" FontWeight="Bold" Foreground="#333333"/>
                        <Grid ColumnDefinitions="*, *">
                            <Button Grid.Column="0" Classes="sidebar" Content="+ Cadastrar Nova Escola" Command="{Binding OpenAddSchoolModalCommand}" BorderBrush="#f0f0f0" BorderThickness="1" Background="#fafaf9" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Classes="sidebar" Content="+ Vincular Novo Diretor" Command="{Binding OpenAddDirectorModalCommand}" BorderBrush="#f0f0f0" BorderThickness="1" Background="#fafaf9" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

              </StackPanel>

              <!-- Painel Escolas -->
              <StackPanel Spacing="25" IsVisible="{Binding IsEscolasVisible}">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel Spacing="5" Grid.Column="0">
                    <TextBlock Text="Gestão de Escolas" FontSize="26" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Gerencie as unidades escolares da rede municipal." FontSize="14" Foreground="#666666"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Command="{Binding OpenAddSchoolModalCommand}" Content="+ Nova Escola" Padding="20,10" CornerRadius="8" FontWeight="Bold"/>
                </Grid>

                <!-- Grid Escolas -->
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding Schools}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 5 0 #05000000">
                          <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                              <TextBlock Text="{Binding Inep, StringFormat='INEP: {0}'}" FontSize="12" Foreground="#999999"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#e6f4ea" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,20,0" IsVisible="{Binding IsActive}">
                              <TextBlock Text="Ativa" FontSize="10" FontWeight="Bold" Foreground="#1e8e3e"/>
                            </Border>
                            <Border Grid.Column="1" Background="#ffebe9" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,20,0" IsVisible="{Binding !IsActive}">
                              <TextBlock Text="Inativa" FontSize="10" FontWeight="Bold" Foreground="#d73a49"/>
                            </Border>
                            
                            <Button Grid.Column="2" Classes="sidebar" Content="Acessar Painel" Command="{ReflectionBinding #RootControl.DataContext.AccessSchoolCommand}" CommandParameter="{Binding}" Foreground="#a98a44" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Grid.Column="3" Classes="sidebar" Content="Editar" Command="{ReflectionBinding #RootControl.DataContext.EditSchoolCommand}" CommandParameter="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Painel Diretores -->
              <StackPanel Spacing="25" IsVisible="{Binding IsDiretoresVisible}">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel Spacing="5" Grid.Column="0">
                    <TextBlock Text="Gestão de Diretores" FontSize="26" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Vincule e gerencie os acessos das direções escolares." FontSize="14" Foreground="#666666"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Command="{Binding OpenAddDirectorModalCommand}" Content="+ Novo Diretor" Padding="20,10" CornerRadius="8" FontWeight="Bold"/>
                </Grid>

                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding Directors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 5 0 #05000000">
                          <Grid ColumnDefinitions="*, *, *, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                              <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#999999"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="Escola Vinculada" FontSize="10" FontWeight="Bold" Foreground="#999999"/>
                              <TextBlock Text="{Binding SchoolName}" FontSize="14" Foreground="#333333"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Telefone" FontSize="10" FontWeight="Bold" Foreground="#999999"/>
                                <TextBlock Text="{Binding Phone}" FontSize="14" Foreground="#333333"/>
                            </StackPanel>
                            <Button Grid.Column="3" Classes="sidebar" Content="Editar" Command="{ReflectionBinding #RootControl.DataContext.EditDirectorCommand}" CommandParameter="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Painel Relatórios -->
              <StackPanel Spacing="25" IsVisible="{Binding IsRelatoriosVisible}">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel Spacing="5" Grid.Column="0">
                    <TextBlock Text="{Binding ReportTitle}" FontSize="26" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Visão de desempenho e frequência demonstrativa." FontSize="14" Foreground="#666666"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Command="{Binding GeneratePdfReportCommand}" Content="📥 Exportar PDF" Padding="20,10" CornerRadius="8" FontWeight="Bold"/>
                </Grid>

                <StackPanel Spacing="10" Margin="0,0,0,10">
                    <TextBlock Text="Filtrar Relatório" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Schools}" SelectedItem="{Binding SelectedReportSchool}" HorizontalAlignment="Stretch" PlaceholderText="Todas as Escolas (Global)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Limpar Filtro" Command="{Binding $parent[UserControl].DataContext.SetSelectedReportSchoolNullCommand}" Margin="10,0,0,0" Background="Transparent" Foreground="#a98a44" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*, *">
                    <!-- Gráfico 1 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,10,0" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Desempenho por Bimestre" FontWeight="Bold" Foreground="#333333"/>
                            
                            <!-- Gráfico de barras simples mockado -->
                            <Grid Height="150" ColumnDefinitions="*,*,*,*" Margin="10,10,10,0">
                                <Border Grid.Column="0" Background="#fdf3de" CornerRadius="4,4,0,0" Width="30" Height="{Binding Bim1Height}" VerticalAlignment="Bottom" />
                                <Border Grid.Column="1" Background="#a98a44" CornerRadius="4,4,0,0" Width="30" Height="{Binding Bim2Height}" VerticalAlignment="Bottom" />
                                <Border Grid.Column="2" Background="#fdf3de" CornerRadius="4,4,0,0" Width="30" Height="{Binding Bim3Height}" VerticalAlignment="Bottom" />
                                <Border Grid.Column="3" Background="#a98a44" CornerRadius="4,4,0,0" Width="30" Height="{Binding Bim4Height}" VerticalAlignment="Bottom" />
                            </Grid>
                            
                            <Grid ColumnDefinitions="*,*,*,*" Margin="10,0">
                                <TextBlock Grid.Column="0" Text="1º Bim" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="2º Bim" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="3º Bim" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="4º Bim" FontSize="11" Foreground="#999999" HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Gráfico 2 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="10,0,0,0" BoxShadow="0 4 15 0 #05000000" BorderBrush="#f0f0f0" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Frequência Média Escolar" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="{Binding FrequenciaMedia}" FontSize="48" FontWeight="Black" Foreground="#a98a44" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                            <TextBlock Text="📈 Oscilação monitorada" FontSize="13" Foreground="#1e8e3e" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
              </StackPanel>

              <!-- ================= INTEGRAÇÃO SOCIAL ================= -->
              <StackPanel Spacing="25" IsVisible="{Binding IsSocialReportVisible}">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel Spacing="5" Grid.Column="0">
                    <TextBlock Text="Relatório Social e Assiduidade" FontSize="32" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Cruzamento de Frequência para Manutenção do Bolsa Família" FontSize="16" Foreground="#666666"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Command="{Binding ExportSocialReportPdfCommand}" Content="🖨️ Imprimir PDF Oficial" Padding="20,10" CornerRadius="8" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Tabela -->
                <Border Background="White" CornerRadius="12" Padding="20" BoxShadow="0 4 15 0 #05000000">
                  <Grid RowDefinitions="Auto, *">
                    <!-- Cabeçalho da Tabela -->
                    <Border Grid.Row="0" Background="#f4f6f8" Padding="15,10" Margin="0,0,0,10" CornerRadius="6"><Grid ColumnDefinitions="2*, 2*, 1.5*, *, *, *, *">
                      <TextBlock Grid.Column="0" Text="Aluno(a)" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Grid.Column="1" Text="Escola" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Grid.Column="2" Text="Turma" FontWeight="Bold" Foreground="#666666"/>
                      <TextBlock Grid.Column="3" Text="Aulas" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="Presenças" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="5" Text="Faltas" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="6" Text="% Frequência" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    </Grid></Border>

                    <!-- Linhas -->
                    <ScrollViewer Grid.Row="1">
                      <ItemsControl ItemsSource="{Binding SocialReportLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#f0f0f0" BorderThickness="0,0,0,1" Padding="15,12" Background="{Binding StatusBackground}">
                              <Grid ColumnDefinitions="2*, 2*, 1.5*, *, *, *, *">
                                <TextBlock Grid.Column="0" Text="{Binding StudentName}" FontWeight="SemiBold" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SchoolName}" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ClassName}" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalClasses}" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding TotalPresences}" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding TotalAbsences}" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding AttendancePercentage, StringFormat={}{0:F1}%}" FontWeight="Black" FontSize="16" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- MODAL ESCOLAS -->
          <Border Background="#80000000" IsVisible="{Binding IsSchoolModalOpen}" ZIndex="10">
            <Border Background="White" CornerRadius="12" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BoxShadow="0 10 30 0 #40000000">
              <StackPanel Spacing="20">
                <TextBlock Text="{Binding ModalTitle}" FontSize="20" FontWeight="Black" Foreground="#333333"/>
                
                <StackPanel Spacing="5">
                  <TextBlock Text="Nome da Escola *" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                  <TextBox Text="{Binding EditingSchool.Name}" Watermark="Ex: Escola Municipal Aurora" Padding="10"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Código INEP" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                  <TextBox Text="{Binding EditingSchool.Inep}" Watermark="Ex: 29000000" Padding="10"/>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="Status" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                  <ComboBox SelectedItem="{Binding EditingSchool.Status}" HorizontalAlignment="Stretch">
                    <x:String>Ativa</x:String>
                    <x:String>Inativa</x:String>
                  </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                  <Button Grid.Column="0" Classes="ghost" Content="Cancelar" Command="{Binding CloseModalCommand}" Background="Transparent" Foreground="#666666" HorizontalAlignment="Left"/>
                  <Button Grid.Column="1" Classes="primary" Content="Salvar" Command="{Binding SaveSchoolCommand}" FontWeight="Bold" HorizontalAlignment="Right" Padding="20,10" CornerRadius="6"/>
                </Grid>
              </StackPanel>
            </Border>
          </Border>

          <!-- MODAL DIRETORES -->
          <Border Background="#80000000" IsVisible="{Binding IsDirectorModalOpen}" ZIndex="10">
            <Border Background="White" CornerRadius="12" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BoxShadow="0 10 30 0 #40000000">
              <StackPanel Spacing="20">
                <TextBlock Text="{Binding DirectorModalTitle}" FontSize="20" FontWeight="Black" Foreground="#333333"/>
                
                <StackPanel Spacing="5">
                  <TextBlock Text="Nome do Diretor(a) *" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                  <TextBox Text="{Binding EditingDirector.Name}" Watermark="Nome completo" Padding="10"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Spacing="5" Margin="0,0,5,0">
                        <TextBlock Text="Telefone" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                        <TextBox Text="{Binding EditingDirector.Phone}" Watermark="(00) 00000-0000" Padding="10"/>
                    </StackPanel>
                    <StackPanel Spacing="5" Margin="5,0,0,0" Grid.Column="1">
                        <TextBlock Text="E-mail" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                        <TextBox Text="{Binding EditingDirector.Email}" Watermark="contato@escola.com" Padding="10"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                  <TextBlock Text="Vincular à Escola" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                  <!-- ComboBox vinculado ao ID da escola -->
                  <ComboBox ItemsSource="{Binding Schools}" SelectedValue="{Binding EditingDirector.SchoolId}" SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                  <Button Grid.Column="0" Classes="ghost" Content="Cancelar" Command="{Binding CloseDirectorModalCommand}" Background="Transparent" Foreground="#666666" HorizontalAlignment="Left"/>
                  <Button Grid.Column="1" Classes="primary" Content="Salvar" Command="{Binding SaveDirectorCommand}" FontWeight="Bold" HorizontalAlignment="Right" Padding="20,10" CornerRadius="6"/>
                </Grid>
              </StackPanel>
            </Border>
          </Border>

        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</UserControl>
