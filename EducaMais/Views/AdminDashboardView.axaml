<UserControl x:Name="RootControl" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EducaMais.ViewModels"
             x:Class="EducaMais.Views.AdminDashboardView"
             x:DataType="vm:AdminDashboardViewModel"
             Background="#f4f4f4">

  <UserControl.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#403d28"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#c84c3f"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    
  </UserControl.Styles>

  <Grid>
    <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="250" PaneBackground="#e8e8e8">
      <SplitView.Pane>
        <StackPanel Spacing="10" Margin="0,20">
          <TextBlock Text="Educa+" FontSize="28" FontWeight="ExtraBold" Foreground="#a98a44" HorizontalAlignment="Center" Margin="0,0,0,30"/>
          
          <Button Content="📊 Dashboard" Command="{Binding ShowDashboardCommand}" Classes="sidebar" Background="Transparent" Foreground="#444444" HorizontalAlignment="Stretch" Padding="20,15" FontWeight="SemiBold"/>
          <Button Content="⚙️ Configurações" Command="{Binding ShowSettingsCommand}" Classes="sidebar" Background="Transparent" Foreground="#444444" HorizontalAlignment="Stretch" Padding="20,15" FontWeight="SemiBold"/>
        </StackPanel>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid RowDefinitions="Auto, *" Background="#f4f4f4">
          <!-- Topbar -->
          <Border Grid.Row="0" Background="White" Padding="20,15" BoxShadow="0 2 5 0 #0D000000">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0" Text="Módulo Superadmin" FontSize="20" FontWeight="Bold" Foreground="#403d28" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="danger" Content="Sair do Sistema" Padding="15,8" CornerRadius="8" Command="{Binding LogoutCommand}"/>
            </Grid>
          </Border>

          <!-- Main Content -->
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="30" Margin="40">
              <Grid>
                <!-- MODAL OVERLAY -->
                <Grid IsVisible="{Binding IsModalOpen}" ZIndex="100" Background="#80000000" Margin="-20,-20,-20,-20">
                  <Border Background="White" CornerRadius="16" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" BoxShadow="0 10 30 0 #40000000">
                    <StackPanel Spacing="20">
                      <TextBlock Text="{Binding SelectedCity}" FontSize="24" FontWeight="Black" Foreground="#333333"/>
                      <TextBlock Text="Preencha as informações do secretário municipal." Foreground="#666666" FontSize="14" Margin="0,-10,0,10"/>
                      
                      <StackPanel Spacing="5">
                        <TextBlock Text="Nome do Secretário(a)" FontWeight="Bold" Foreground="#333333"/>
                        <TextBox Text="{Binding SecretaryName}" Watermark="Ex: Maria Joaquina" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0"/>
                      </StackPanel>
                      
                      <StackPanel Spacing="5">
                        <TextBlock Text="Telefone" FontWeight="Bold" Foreground="#333333"/>
                        <TextBox Text="{Binding SecretaryPhone}" Watermark="(00) 00000-0000" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0"/>
                      </StackPanel>

                      <StackPanel Spacing="5">
                        <TextBlock Text="E-mail" FontWeight="Bold" Foreground="#333333"/>
                        <TextBox Text="{Binding SecretaryEmail}" Watermark="secretario@cidade.ba.gov.br" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0"/>
                      </StackPanel>

                      <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CloseModalCommand}" Background="Transparent" Foreground="#666666" FontWeight="Bold" HorizontalAlignment="Center" Padding="20,15"/>
                        <Button Grid.Column="1" Content="Salvar" Command="{Binding SaveSecretaryCommand}" Background="#a98a44" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="20,15"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- CONTEÚDO DO DASHBOARD -->
                <StackPanel IsVisible="{Binding IsDashboardVisible}" Spacing="25" Margin="0,0,0,40">
                  <!-- Title -->
                  <StackPanel Spacing="5">
                    <TextBlock Text="Quarta-feira, 17 de setembro de 2026" FontSize="12" Foreground="#999999"/>
                    <TextBlock Text="Acesso Administrativo" FontSize="26" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Visão global de todas as secretarias e configurações do sistema." FontSize="14" Foreground="#666666"/>
                  </StackPanel>

                  <!-- Acesso rápido: Municípios -->
                  <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 10 0 #05000000">
                    <StackPanel Spacing="15">
                      <TextBlock Text="Acessar Município" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                      <TextBlock Text="Selecione um município da Bahia para gerenciar seus acessos:" FontSize="14" Foreground="#666666"/>
                      <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" PlaceholderText="Escolha um município..." HorizontalAlignment="Stretch" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0" MaxDropDownHeight="300"/>
                    </StackPanel>
                  </Border>

                  <!-- Cards -->
                  <UniformGrid Columns="3">
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 10 0 #05000000">
                      <StackPanel Spacing="15">
                        <Border Background="#fdf3de" CornerRadius="6" Width="32" Height="32" HorizontalAlignment="Left">
                          <TextBlock Text="🏢" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#a98a44"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="{Binding TotalMunicipalities}" FontSize="28" FontWeight="Black" Foreground="#333333"/>
                          <TextBlock Text="Secretarias Municipais" FontSize="13" Foreground="#999999"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="10,0" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 10 0 #05000000">
                      <StackPanel Spacing="15">
                        <Border Background="#fdf3de" CornerRadius="6" Width="32" Height="32" HorizontalAlignment="Left">
                          <TextBlock Text="🏫" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#a98a44"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="{Binding TotalSchools}" FontSize="28" FontWeight="Black" Foreground="#333333"/>
                          <TextBlock Text="Escolas na Rede" FontSize="13" Foreground="#999999"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 10 0 #05000000">
                      <StackPanel Spacing="15">
                        <Border Background="#fdf3de" CornerRadius="6" Width="32" Height="32" HorizontalAlignment="Left">
                          <TextBlock Text="🎓" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#a98a44"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="{Binding TotalStudents}" FontSize="28" FontWeight="Black" Foreground="#333333"/>
                          <TextBlock Text="Total de Alunos" FontSize="13" Foreground="#999999"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <!-- Lista de Secretarias (Recentes) -->
                  <StackPanel Spacing="10" Margin="0,15,0,0">
                    <TextBlock Text="Secretarias Registradas" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Municipalities}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 5 0 #05000000">
                            <Grid ColumnDefinitions="*, *, Auto">
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#333333"/>
                                <TextBlock Text="ID da Rede" FontSize="12" Foreground="#999999"/>
                              </StackPanel>
                              
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SecretaryName}" FontSize="14" Foreground="#444444"/>
                                <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#999999"/>
                              </StackPanel>

                              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button ToolTip.Tip="Acessar Painel" Command="{ReflectionBinding #RootControl.DataContext.AccessSecretaryCommand}" CommandParameter="{Binding}" Background="#fdf3de" Foreground="#a98a44" CornerRadius="6" FontWeight="SemiBold" Padding="10,8">
                                  <TextBlock Text="Acessar"/>
                                </Button>
                                <Button ToolTip.Tip="Editar Secretaria" Command="{ReflectionBinding #RootControl.DataContext.EditSecretaryCommand}" CommandParameter="{Binding}" Background="#e6f4ea" Foreground="#1e8e3e" CornerRadius="6" FontWeight="SemiBold" Padding="10,8">
                                  <TextBlock Text="Editar"/>
                                </Button>
                                <Button ToolTip.Tip="Gerar Credencial" Command="{ReflectionBinding #RootControl.DataContext.GenerateCredentialsCommand}" CommandParameter="{Binding}" Background="#e0e0e0" Foreground="#333333" CornerRadius="6" FontWeight="SemiBold" Padding="10,8"><TextBlock Text="Gerar Acesso"/></Button>
                                <Button ToolTip.Tip="Excluir Secretaria" Command="{ReflectionBinding #RootControl.DataContext.DeleteSecretaryCommand}" CommandParameter="{Binding}" Background="#fce8e6" Foreground="#d93025" CornerRadius="6" FontWeight="SemiBold" Padding="10,8">
                                  <TextBlock Text="Excluir"/>
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                </StackPanel>

                <!-- CONTEÚDO DE CONFIGURAÇÕES -->
                <StackPanel IsVisible="{Binding IsSettingsVisible}" Spacing="25" Margin="0,0,0,40">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Configurações do Sistema" FontSize="26" FontWeight="Black" Foreground="#333333"/>
                    <TextBlock Text="Ajustes gerais do Superadmin." FontSize="14" Foreground="#666666"/>
                  </StackPanel>

                  <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#f0f0f0" BorderThickness="1" BoxShadow="0 2 10 0 #05000000">
                    <StackPanel Spacing="20">
                      <TextBlock Text="Dados do Administrador" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                      
                      <StackPanel Spacing="5">
                        <TextBlock Text="E-mail de Recuperação" FontWeight="Bold" Foreground="#333333"/>
                        <TextBox Text="admin@educamais.com.br" IsEnabled="False" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0"/>
                      </StackPanel>
                      
                      <StackPanel Spacing="5">
                        <TextBlock Text="Chave da API Appwrite" FontWeight="Bold" Foreground="#333333"/>
                        <TextBox Text="****************************************" IsEnabled="False" Padding="15" CornerRadius="8" Background="#f9f9f9" BorderBrush="#e0e0e0"/>
                      </StackPanel>

                      <Button Content="Salvar Configurações" Background="#a98a44" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" CornerRadius="8" Padding="20,15"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

              </Grid>
            </StackPanel>
          </ScrollViewer>

              <!-- MODAL CREDENCIAIS -->
              <Border Background="#80000000" IsVisible="{Binding IsCredentialsModalOpen}" ZIndex="200" Margin="-20,-20,-20,-20">
                <Border Background="White" CornerRadius="12" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BoxShadow="0 10 30 0 #40000000">
                  <StackPanel Spacing="20">
                    <TextBlock Text="Acesso Gerado" FontSize="20" FontWeight="Black" Foreground="#1e8e3e"/>
                    <TextBlock Text="{Binding GeneratedCredentialsMessage}" TextWrapping="Wrap" FontSize="14" Foreground="#333333" LineHeight="20"/>
                    <Button Content="Ok, fechar" Command="{Binding CloseCredentialsModalCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" CornerRadius="8" FontWeight="Bold"/>
                  </StackPanel>
                </Border>
              </Border>
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</UserControl>
